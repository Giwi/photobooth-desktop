{
  "name": "photobooth-desktop",
  "version": "0.0.1",
  "description": "Photobooth desktop app built with Electrobun",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "electrobun dev --watch",
    "build": "electrobun build",
    "build:canary": "electrobun build --env=canary",
    "build:stable": "electrobun build --env=stable",
    "start": "electrobun start",
    "setup:desktop": "bash scripts/setup-desktop.sh"
  },
  "dependencies": {
    "electrobun": "^1.18.1",
    "preact": "^10.29.7"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
